PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# OpenRouter AI
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# OpenRouteService Maps
ORS_API_KEY=your-openrouteservice-key
ORS_BASE_URL=https://api.openrouteservice.org

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Email Dispatch Mode: 'resend' (24/7 Direct Cloud), 'n8n' (n8n Webhooks), or 'both'
EMAIL_PROVIDER=resend

# n8n Automation Webhooks (Optional)
N8N_DONATION_CREATED_WEBHOOK_URL=http://localhost:5678/webhook/donation-created
N8N_DONATION_ACCEPTED_WEBHOOK_URL=http://localhost:5678/webhook/donation-accepted

# Resend 24/7 Cloud Email Automation (Free Tier: 3,000 emails/mo)
RESEND_API_KEY=re_your_free_resend_api_key
EMAIL_FROM=FoodLink AI <onboarding@resend.dev>

